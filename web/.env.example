# Solana RPC (local validator by default; devnet works too once programs are deployed)
SOLANA_RPC_URL=http://127.0.0.1:8899
# Wallet that pays for setup (admin / lender). Defaults to ~/.config/solana/id.json
SOLANA_WALLET=
# Optional: Claude picks the products. Without it, a rules-based picker is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
